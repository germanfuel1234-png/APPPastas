# =============================================================
# Configuración de la aplicación "Fábrica de Pastas"
# Copia este archivo como ".env" y completa los valores.
# =============================================================

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fabrica_pastas

# ---------- Mercado Pago (Checkout Pro) ----------
# Credenciales desde https://www.mercadopago.com.ar/developers
# (usa las de prueba para desarrollo: "TEST-xxxx-...")
MP_ACCESS_TOKEN=TEST-0000000000000000-0000000000000000-000000000-000000000

# URL pública que recibe los webhooks de Mercado Pago.
# Debe apuntar a este backend terminando en /api/webhooks/mercadopago
# Ejemplo local: deja vacío. Para probar pagos reales/externos usa un túnel
# como ngrok:  https://xxxx.ngrok-free.app/api/webhooks/mercadopago
MP_NOTIFICATION_URL=

# Email del pagador (invitado). Mercado Pago requiere un email en la preferencia.
MP_PAYER_EMAIL=invitado@fabrica-pastas.local

# URLs de redirección al volver del checkout (opcional).
# Si configuras "success", el checkout vuelve automáticamente al aprobar el pago.
MP_BACK_URL_SUCCESS=
MP_BACK_URL_PENDING=
MP_BACK_URL_FAILURE=

# Secreto de firma del webhook (panel de la app en Mercado Pago > Webhooks >
# "Firma secreta"). Si queda vacío, el webhook no valida x-signature
# (solo aceptable en desarrollo).
MP_WEBHOOK_SECRET=

# ---------- Servidor backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Orígenes permitidos por CORS, coma-separado. "*" = cualquiera (default).
# Restringir en producción, ej: https://mi-panel-admin.com,https://otra-app.com
CORS_ORIGINS=*

# Token del personal para marcar órdenes como ENTREGADO (POST /api/ordenes/{id}/entregar).
# Es exclusivo del backend: NO se lee desde el cliente Flet, se tipea a mano
# en la app cuando el personal confirma una entrega (ver app/views/estado.py).
ADMIN_TOKEN=cambiar-me

# ---------- Cliente (app Flet) ----------
# URL base del backend que consume la app.
API_BASE_URL=http://127.0.0.1:8000